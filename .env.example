# Vigil configuration. Copy to .env if you want one, or set the variables in your shell.
# The server reads the environment directly; there is no dotenv loader.

# Server bind address. A non-loopback bind requires VIGIL_TOKEN.
HOST=127.0.0.1
# Server port.
PORT=3001
# API bearer token and login password. Unset by default; required for a non-loopback bind.
VIGIL_TOKEN=
# Extra allowed Host header names, comma separated, for a reverse proxy domain. Empty by default.
VIGIL_ALLOWED_HOSTS=
# Vault directory holding the markdown notes. Defaults to <repo>/vault.
VAULT_DIR=
# Disposable index database. Defaults to <repo>/data/index.db.
DB_PATH=
# Durable state database. Defaults to <repo>/data/state.db.
STATE_DB_PATH=
# LangGraph checkpoint database (WP8). Defaults to <repo>/data/checkpoints.db.
CHECKPOINT_DB_PATH=
# Session key file for login cookies (WP12). Defaults to <repo>/data/session.key.
SESSION_KEY_PATH=
# Model provider: openai or ollama.
VIGIL_LLM_PROVIDER=openai
# Model endpoint. Defaults to the OpenAI URL, or http://127.0.0.1:11434 for ollama.
VIGIL_LLM_BASE_URL=
# Endpoint API key. Never stored, logged or returned by the API.
VIGIL_LLM_API_KEY=
# Default model; an agent may override it.
VIGIL_LLM_MODEL=
# Ollama only: context window in tokens (default 16384). Ollama's own default of 4096 can leave a thinking model with an empty reply.
VIGIL_LLM_NUM_CTX=
# Optional: the secret that encrypts model keys you save in Settings (16+ characters). Without it a key file `secret.key` is made next to state.db.
VIGIL_SECRET_KEY=
# Default time zone for cron schedules (WP2). Defaults to the system zone.
VIGIL_TZ=
# How old a missed cron tick may be and still get one catch-up run on start (hours, default 24).
VIGIL_CATCHUP_HOURS=
# Soft monthly token cap (WP3). Unset means no cap.
VIGIL_MONTHLY_TOKEN_CAP=
# Hard monthly token cap (ADR-0032). At this total no new run or chat turn starts. Unset means no hard cap.
VIGIL_MONTHLY_TOKEN_HARD_CAP=
# Webhook for runs nobody watches (approval needed, failed, finished cron or heartbeat). One JSON POST, no note text. Unset means off.
VIGIL_WEBHOOK_URL=
# Directory holding the built web app to serve (WP12). Unset means the API only.
VIGIL_STATIC_DIR=
# Force the Secure cookie flag (WP12): auto, true or false.
VIGIL_COOKIE_SECURE=auto
